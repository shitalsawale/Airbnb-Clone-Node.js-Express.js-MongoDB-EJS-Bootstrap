<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Login</h1>

    <div class="col-6 offset-3">
        <form action="/login" method="POST" class="needs-validation" novalidate>

            <!-- Username -->
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input
                    type="text"
                    id="username"
                    name="username"
                    class="form-control"
                    required
                >
                
            </div>

           

            <!-- Password -->
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>

            <!-- Sign Up Button -->
            <button type="Login" class="btn btn-success">
                Sign Up
            </button>

        </form>
    </div>
</div>